# Copy this file to .env and set real values for your local environment.
# Required for local startup/readiness: set CONNECTIONSTRINGS__MAIN or SQLSERVER_* values.

# Preferred local setup (assembled into ConnectionStrings:Main):
SQLSERVER_HOST=(localdb)\MSSQLLocalDB
SQLSERVER_DB=ioc_manager_dev
SQLSERVER_TRUSTED_CONNECTION=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# Optional SQL authentication settings (only when not using trusted connection):
# SQLSERVER_PORT=1433
# SQLSERVER_USER=sa
# SQLSERVER_PASSWORD=change-me

# Optional: provide a full connection string override instead of SQLSERVER_* values.
# CONNECTIONSTRINGS__MAIN=Server=(localdb)\MSSQLLocalDB;Database=ioc_manager_dev;Trusted_Connection=True;TrustServerCertificate=True

# Optional: backend -> AI sidecar integration overrides.
# AISIDECAR__BASEURL=http://localhost:8100
# AISIDECAR__REPORTEXTRACTIONPATH=/extract_report
# AISIDECAR__TIMEOUTSECONDS=30

# Optional bootstrap admin override.
# Development defaults in appsettings.Development.json already enable:
#   username: admin.ops
#   password: adminaccess123
# Set these variables to override the defaults.
# AUTH__BOOTSTRAPADMIN__ENABLED=true
# AUTH__BOOTSTRAPADMIN__USERNAME=admin.ops
# AUTH__BOOTSTRAPADMIN__EMAIL=admin@local.test
# AUTH__BOOTSTRAPADMIN__PASSWORD=adminaccess123
