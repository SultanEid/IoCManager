model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectQuery to AS - DeTechTive_semantic_model 3"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Dim_Calendar 4'
ref table 'Alert 4'
ref table 'NETWORK 4'
ref table 'Target 4'
ref table '_Measures 4'
ref table 'Fact_IOCs 3'

ref cultureInfo en-US
