# Copy this file to .env.local and export the values for your shell session.
# Only set values you want to override; defaults are resolved in cti_service/config.py.

CTI_SIDECAR_ENV=development
CTI_SIDECAR_SERVICE_NAME=ioc-ingestion-sidecar

# Optional explicit paths (recommended as absolute paths if you override):
# CTI_SIDECAR_ARTIFACTS_ROOT=C:/Users/46/Desktop/Project/ai/service/artifacts
# CTI_SIDECAR_ACTION_POLICY_MATRIX_PATH=C:/Users/46/Desktop/Project/ai/service/artifacts/action_policy_matrix.v1.json
# CTI_SIDECAR_REGISTRY_PATH=C:/Users/46/Desktop/Project/ai/service/artifacts/model_registry.json
# CTI_SIDECAR_DATASET_REGISTRY_PATH=C:/Users/46/Desktop/Project/ai/service/artifacts/dataset_registry.json
# CTI_SIDECAR_FEEDBACK_PATH=C:/Users/46/Desktop/Project/ai/service/artifacts/feedback_events.jsonl
# CTI_SIDECAR_SNAPSHOT_ROOT=C:/Users/46/Desktop/Project/ai/data/snapshots
# CTI_SIDECAR_HISTORICAL_DEFAULT_TOP_K=10
# CTI_SIDECAR_HISTORICAL_LOOKBACK_DAYS=90
# CTI_SIDECAR_HISTORICAL_DECAY_HALF_LIFE_DAYS=45

# Optional dataset pin:
# CTI_SIDECAR_DATASET_VERSION=v2026.03

# Optional LLM-assisted phrasing layer (deterministic-first, fallback-safe):
# CTI_ENABLE_LLM_ASSIST=true
# CTI_LLM_ASSIST_PROVIDER=openai
# CTI_LLM_ASSIST_MODEL=gpt-5.4-mini
# CTI_LLM_ASSIST_TIMEOUT_MS=8000
