{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ioc-manager.local/schemas/action-plan.schema.json",
  "title": "Action Plan",
  "description": "Deterministic post-decision action plan with policy checks and manual-only execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "recommended_actions",
    "prerequisites",
    "cautions",
    "never_auto_executes",
    "policy_constrained",
    "evidence_based",
    "machine_readable"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "recommended_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/recommended_action"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cautions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "never_auto_executes": {
      "const": true
    },
    "policy_constrained": {
      "const": true
    },
    "evidence_based": {
      "const": true
    },
    "machine_readable": {
      "$ref": "#/$defs/machine_readable"
    }
  },
  "$defs": {
    "action_name": {
      "type": "string",
      "enum": [
        "isolate_host",
        "quarantine_file",
        "block_hash",
        "block_domain",
        "block_url",
        "block_ip",
        "search_fleet",
        "collect_memory",
        "collect_process_tree",
        "collect_persistence_artifacts",
        "collect_network_context",
        "tighten_rule",
        "suppress_rule_candidate",
        "open_review",
        "notify_admin",
        "notify_analyst",
        "notify_it_operator",
        "no_immediate_action"
      ]
    },
    "recommended_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "rank",
        "score",
        "rationale",
        "prerequisites",
        "cautions",
        "escalation_target",
        "required_reviewer_role",
        "requires_human_approval",
        "execution_mode"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/action_name"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cautions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "escalation_target": {
          "type": "string",
          "enum": [
            "none",
            "analyst_queue",
            "security_admin",
            "it_operator",
            "incident_response"
          ]
        },
        "required_reviewer_role": {
          "type": "string",
          "enum": [
            "tier1_analyst",
            "tier2_detection_engineer",
            "incident_responder"
          ]
        },
        "requires_human_approval": {
          "const": true
        },
        "execution_mode": {
          "const": "manual_only"
        }
      }
    },
    "policy_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "passed",
        "details"
      ],
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "details": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action_score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "eligible",
        "score",
        "rationale",
        "blocked_reasons"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/action_name"
        },
        "eligible": {
          "type": "boolean"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "blocked_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "machine_readable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_snapshot",
        "policy_checks",
        "action_scores",
        "selection"
      ],
      "properties": {
        "input_snapshot": {
          "type": "object"
        },
        "policy_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policy_check"
          }
        },
        "action_scores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action_score"
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_actions",
            "fallback_to_no_immediate_action",
            "selected_actions",
            "policy_matrix_version",
            "matched_policy_row_id",
            "matched_policy_row_priority",
            "policy_allowed_actions",
            "derived_confidence_bucket",
            "derived_false_positive_risk_bucket"
          ],
          "properties": {
            "max_actions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "fallback_to_no_immediate_action": {
              "type": "boolean"
            },
            "selected_actions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/action_name"
              }
            },
            "policy_matrix_version": {
              "type": "string",
              "minLength": 1
            },
            "matched_policy_row_id": {
              "type": "string",
              "minLength": 1
            },
            "matched_policy_row_priority": {
              "type": "integer"
            },
            "policy_allowed_actions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/action_name"
              }
            },
            "derived_confidence_bucket": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "derived_false_positive_risk_bucket": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "summary": "Generated 3 policy-constrained manual-only actions for verdict likely_malicious.",
      "recommended_actions": [
        {
          "action": "isolate_host",
          "rank": 1,
          "score": 0.92,
          "rationale": "isolate_host prioritized for malicious-like verdict with low false-positive risk.",
          "prerequisites": [
            "Validate host identity and active owner before containment."
          ],
          "cautions": [
            "Host isolation can interrupt production workloads."
          ],
          "escalation_target": "incident_response",
          "required_reviewer_role": "incident_responder",
          "requires_human_approval": true,
          "execution_mode": "manual_only"
        },
        {
          "action": "search_fleet",
          "rank": 2,
          "score": 0.84,
          "rationale": "search_fleet prioritized to validate spread across related detections.",
          "prerequisites": [
            "Scope search to relevant tenants, regions, and lookback window."
          ],
          "cautions": [
            "Large-scope searches can increase SIEM/EDR query load."
          ],
          "escalation_target": "incident_response",
          "required_reviewer_role": "incident_responder",
          "requires_human_approval": true,
          "execution_mode": "manual_only"
        },
        {
          "action": "open_review",
          "rank": 3,
          "score": 0.68,
          "rationale": "open_review prioritized due to uncertainty/conflict that requires analyst validation.",
          "prerequisites": [
            "Attach decision evidence summary and policy check trace."
          ],
          "cautions": [
            "Manual review queues can add response latency."
          ],
          "escalation_target": "incident_response",
          "required_reviewer_role": "incident_responder",
          "requires_human_approval": true,
          "execution_mode": "manual_only"
        }
      ],
      "prerequisites": [
        "Validate host identity and active owner before containment.",
        "Scope search to relevant tenants, regions, and lookback window."
      ],
      "cautions": [
        "Host isolation can interrupt production workloads.",
        "Manual review queues can add response latency."
      ],
      "never_auto_executes": true,
      "policy_constrained": true,
      "evidence_based": true,
      "machine_readable": {
        "input_snapshot": {
          "family": "sigma",
          "verdict": "likely_malicious",
          "confidence": 0.82,
          "false_positive_risk": 0.19
        },
        "policy_checks": [
          {
            "check": "manual_execution_only",
            "passed": true,
            "details": "All recommended actions require explicit human approval and manual execution."
          }
        ],
        "action_scores": [
          {
            "action": "isolate_host",
            "eligible": true,
            "score": 0.92,
            "rationale": "isolate_host prioritized for malicious-like verdict with low false-positive risk.",
            "blocked_reasons": []
          }
        ],
        "selection": {
          "max_actions": 3,
          "fallback_to_no_immediate_action": false,
          "policy_matrix_version": "v1",
          "matched_policy_row_id": "malicious_high_low_critical",
          "matched_policy_row_priority": 120,
          "policy_allowed_actions": [
            "isolate_host",
            "search_fleet",
            "open_review",
            "notify_admin",
            "no_immediate_action"
          ],
          "derived_confidence_bucket": "high",
          "derived_false_positive_risk_bucket": "low",
          "selected_actions": [
            "isolate_host",
            "search_fleet",
            "open_review"
          ]
        }
      }
    }
  ]
}

