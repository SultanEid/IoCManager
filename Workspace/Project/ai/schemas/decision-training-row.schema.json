{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ioc-manager.local/schemas/decision-training-row.schema.json",
  "title": "Decision Training Row",
  "description": "Canonical JSONL row contract for decision dataset building.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "row_id",
    "dataset_version",
    "task_type",
    "rule_family",
    "package_payload",
    "target_payload",
    "provenance",
    "evidence_used",
    "evidence_missing",
    "raw_payload",
    "parser_diagnostics",
    "group_key",
    "event_time_utc",
    "source_file",
    "is_partial",
    "missing_fields",
    "eligible_tasks"
  ],
  "properties": {
    "row_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "rule_family": {
      "type": "string",
      "minLength": 1
    },
    "package_payload": {
      "type": "object"
    },
    "target_payload": {
      "type": "object"
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenance_item"
      }
    },
    "evidence_used": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_missing": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "raw_payload": {
      "type": "object"
    },
    "parser_diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parser_diagnostic"
      }
    },
    "group_key": {
      "type": "string",
      "minLength": 1
    },
    "event_time_utc": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_file": {
      "$ref": "#/$defs/source_file"
    },
    "is_partial": {
      "type": "boolean"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "eligible_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "provenance_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "key",
        "value",
        "evidence_id",
        "citation_ref",
        "retrieved_at_utc",
        "retrieved_by",
        "record_locator"
      ],
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "citation_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_name",
        "source_name",
        "source_type",
        "source_path",
        "record_locator",
        "loader",
        "parser_name"
      ],
      "properties": {
        "manifest_name": {
          "type": "string",
          "minLength": 1
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "record_locator": {
          "type": "string",
          "minLength": 1
        },
        "loader": {
          "type": "string",
          "minLength": 1
        },
        "parser_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parser_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "field_path",
        "adapter"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "field_path": {
          "type": "string"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

