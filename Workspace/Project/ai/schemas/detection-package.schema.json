          }
        ]
      },
      "behavior_report_references": {
        "reports": [
          {
            "report_id": "rep-115",
            "source": "sandbox-cluster",
            "reference": "https://internal.example/reports/rep-115",
            "summary": "Observed encoded command spawning network connections."
          }
        ]
      },
      "prior_analyst_outcomes": {
        "outcomes": [
          {
            "analyst_id": "u-205",
            "case_id": "case-5001",
            "verdict": "likely_malicious",
            "timestamp": "2026-04-10T10:00:00Z",
            "notes": "Similar encoded PowerShell pattern."
          }
        ]
      },
      "related_detections": {
        "detections": [
          {
            "detection_id": "det-903",
            "rule_family": "snort",
            "rule_id": "SNRT-4455",
            "relation_type": "supporting_signal",
            "observed_at": "2026-04-15T20:01:00Z",
            "confidence": 0.74
          }
        ]
      }
    }
  ]
}
