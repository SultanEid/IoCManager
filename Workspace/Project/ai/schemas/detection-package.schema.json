        "allowlisted": false,
        "baseline_match": false,
        "baseline_name": "default-endpoint-powershell",
        "allowlist_source": "soc-baseline-registry"
      },
      "linked_enrichment": {
        "enrichments": [
          {
            "kind": "reputation",
            "value": {
              "score": 89
            },
            "source": "intel-provider-a",
