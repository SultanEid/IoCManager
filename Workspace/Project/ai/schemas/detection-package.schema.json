        "command_line": "powershell.exe -enc SQBFAFgA",
        "host": "workstation-44"
      },
      "object_metadata": {
        "object_id": "obj-991",
        "object_type": "process_event",
        "source_system": "siem",
        "labels": [
          "windows",
          "powershell"
        ]
      },
      "asset_context": {
        "asset_id": "asset-22",
        "asset_name": "wkstn-finance-22",
