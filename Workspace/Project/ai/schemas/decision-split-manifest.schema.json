{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ioc-manager.local/schemas/decision-split-manifest.schema.json",
  "title": "Decision Dataset Split Manifest",
  "description": "Deterministic metadata for decision dataset task/split outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasetVersion",
    "generatedAtUtc",
    "buildStartedAtUtc",
    "seed",
    "splitRatios",
    "manifests",
    "rows",
    "files",
    "tasks",
    "skippedItems"
  ],
  "properties": {
    "datasetVersion": {
      "type": "string",
      "minLength": 1
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "buildStartedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "seed": {
      "type": "integer"
    },
    "splitRatios": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train",
        "validation",
        "test"
      ],
      "properties": {
        "train": {
          "type": "number"
        },
        "validation": {
          "type": "number"
        },
        "test": {
          "type": "number"
        }
      }
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "paths"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rows": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "canonical",
        "partial",
        "byRuleFamily",
        "withProvenance",
        "provenanceCoverage"
      ],
      "properties": {
        "canonical": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "byRuleFamily": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "withProvenance": {
          "type": "integer",
          "minimum": 0
        },
        "provenanceCoverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rowsWithProvenanceRatio",
            "rowsWithRequiredFieldsRatio"
          ],
          "properties": {
            "rowsWithProvenanceRatio": {
              "type": "number"
            },
            "rowsWithRequiredFieldsRatio": {
              "type": "number"
            }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "tasks",
        "splits"
      ],
      "properties": {
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "splits": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "taskRows",
          "splitEligibleRows",
          "excludedFromSplits",
          "partialRows",
          "splitRowCounts",
          "splitGroupCounts",
          "leakageAssertions"
        ]
      }
    },
    "skippedItems": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}

