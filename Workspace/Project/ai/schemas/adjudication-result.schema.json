{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ioc-manager.local/schemas/adjudication-result.schema.json",
  "title": "Adjudication Result",
  "description": "Canonical adjudication output contract for AI-assisted decisioning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "confidence",
    "false_positive_risk",
    "review_priority",
    "should_promote_to_indicator",
    "should_suppress",
    "should_allowlist",
    "should_escalate",
    "evidence_used",
    "evidence_missing",
    "contradictory_evidence",
    "explanation",
    "suggested_next_checks"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "benign",
        "likely_benign",
        "suspicious",
        "likely_malicious",
        "malicious",
        "false_positive",
        "insufficient_evidence",
        "stale_or_revoked"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "false_positive_risk": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "should_promote_to_indicator": {
      "type": "boolean"
    },
    "should_suppress": {
      "type": "boolean"
    },
    "should_allowlist": {
      "type": "boolean"
    },
    "should_escalate": {
      "type": "boolean"
    },
    "evidence_used": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_reference"
      }
    },
    "evidence_missing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_gap"
      }
    },
    "contradictory_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_reference"
      }
    },
    "promotion_decision": {
      "$ref": "#/$defs/decision_block"
    },
    "suppression_decision": {
      "$ref": "#/$defs/decision_block"
    },
    "escalation_decision": {
      "$ref": "#/$defs/decision_block"
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "suggested_next_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_check"
      }
    }
  },
  "$defs": {
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source",
        "summary"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "evidence_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "description",
        "importance"
      ],
      "properties": {
        "gap_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "decision_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "rationale"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "recommended",
            "not_recommended",
            "defer"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "reason"
      ],
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "verdict": "likely_malicious",
      "confidence": 0.78,
      "false_positive_risk": 0.18,
      "review_priority": "high",
      "should_promote_to_indicator": true,
      "should_suppress": false,
      "should_allowlist": false,
      "should_escalate": true,
      "evidence_used": [
        {
          "evidence_id": "ev-1001",
          "source": "sigma",
          "summary": "Rundll32 JavaScript execution from endpoint telemetry.",
          "reference": "internal://detections/det-332",
          "confidence": 0.82
        }
      ],
      "evidence_missing": [
        {
          "gap_id": "gap-13",
          "description": "No host-level memory artifact correlation yet.",
          "importance": "medium"
        }
      ],
      "contradictory_evidence": [],
      "promotion_decision": {
        "state": "recommended",
        "rationale": "Signal quality is high and corroborated by process telemetry.",
        "conditions": [
          "limit rollout to canary assets first"
        ]
      },
      "suppression_decision": {
        "state": "not_recommended",
        "rationale": "No allowlist or stable baseline evidence supports suppression."
      },
      "escalation_decision": {
        "state": "recommended",
        "rationale": "Potential lateral movement precursor on finance assets."
      },
      "explanation": "Corroborated suspicious execution behavior supports a likely malicious verdict with manageable FP risk.",
      "suggested_next_checks": [
        {
          "check": "Collect parent-child process ancestry for affected hosts.",
          "reason": "Validate potential scripted staging chain.",
          "priority": "high"
        }
      ]
    }
  ]
}
