{
    "name": "workbench",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "scope:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/check-ioc-scope.ps1",
        "typecheck": "tsc --noEmit",
        "test": "vitest --configLoader native --pool threads",
        "test:run": "vitest run --configLoader native --pool threads",
        "test:coverage": "vitest run --coverage --configLoader native --pool threads",
        "test:e2e": "npx @playwright/test test",
        "test:e2e:headed": "npx @playwright/test test --headed"
    },
    "dependencies": {
        "@base-ui/react": "^1.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.2.8",
        "@fontsource-variable/manrope": "^5.2.8",
        "@monaco-editor/react": "^4.7.0",
        "@tanstack/react-query": "^5.90.21",
        "@tanstack/react-table": "^8.21.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "cytoscape": "^3.33.1",
        "framer-motion": "^12.6.3",
        "jose": "^6.2.1",
        "lucide-react": "^0.577.0",
        "monaco-editor": "^0.55.1",
        "next": "16.1.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "shadcn": "^4.0.5",
        "tailwind-merge": "^3.5.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.2",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/postcss": "^4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitest/coverage-v8": "^4.1.0",
        "eslint": "^9",
        "eslint-config-next": "16.1.6",
        "jsdom": "^28.1.0",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^4.1.0"
    }
}
