{
  "ConnectionStrings": {
    "Main": "Server=(localdb)\\MSSQLLocalDB;Database=ioc_manager;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "ConnectionStringName": "Main",
    "ApplyMigrationsOnStartup": false
  },
  "Auth": {
    "Jwt": {
    "Issuer": "ioc-manager",
    "Audience": "ioc-manager-clients",
      "SigningKey": "",
      "AccessTokenLifetimeMinutes": 60
    },
    "Identity": {
      "LockoutAllowedForNewUsers": true,
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15
    },
    "BootstrapAdmin": {
      "Enabled": false,
      "UserName": "",
      "Email": "",
      "Password": "",
      "Role": "Admin"
    }
  },
  "Jobs": {
    "EnableModelRetraining": true,
    "ModelRetrainingIntervalHours": 24,
    "SystemActorUserId": "system-worker"
  },
  "AiSidecar": {
    "BaseUrl": "http://127.0.0.1:8100",
    "ReportExtractionPath": "/extract_report",
    "TimeoutSeconds": 30
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}
