{
  "ConnectionStrings": {
    "Main": "Server=(localdb)\\MSSQLLocalDB;Database=ioc_manager_dev;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "LegacyAzureCompatibility": {
    "Enabled": true,
    "ConnectionStringName": "Main"
  },
  "Auth": {
    "Jwt": {
      "SigningKey": "dev-signing-key-change-before-production-0123456789"
    },
    "SqlUserTable": {
      "Enabled": true,
      "AcceptPreHashedPassword": true,
      "TableName": "[dbo].[User]",
      "DevelopmentFallbackEnabled": true,
      "DevelopmentFallbackUserName": "team",
      "DevelopmentFallbackEmail": "team@local.test",
      "DevelopmentFallbackPassword": "team123",
      "DevelopmentFallbackRole": "Admin"
    },
    "Identity": {
      "LockoutAllowedForNewUsers": true,
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 10
    },
    "BootstrapAdmin": {
      "Enabled": true,
      "UserName": "admin.ops",
      "Email": "admin@local.test",
      "Password": "change-me-local",
      "Role": "Admin"
    }
  },
  "Reporting": {
    "PowerBi": {
      "Enabled": false,
      "AllowDevelopmentPlaceholders": true,
      "DefaultVisualizationKey": "security-overview",
      "Workspaces": [
        {
          "Key": "security-ops",
          "DisplayName": "Security Operations",
          "Description": "Development placeholder metadata until live Power BI embeds are configured.",
          "WorkspaceId": "",
          "RequiresUserSignIn": true,
          "Reports": [
            {
              "Key": "security-overview",
              "Title": "Security Overview",
              "Description": "Executive posture, detection volume, and alert pressure.",
              "ReportId": "",
              "EmbedUrl": "",
              "IsDefault": true,
              "IsEnabled": true,
              "EmbedHeightPx": 760,
              "Tags": [ "Executive", "Threat", "Operations" ],
              "AllowedRoles": [ "Analyst", "Lead", "Admin" ]
            },
            {
              "Key": "rule-efficiency",
              "Title": "Rule Efficiency",
              "Description": "Rule quality, noise ratio, and distribution impact.",
              "ReportId": "",
              "EmbedUrl": "",
              "IsDefault": false,
              "IsEnabled": true,
              "EmbedHeightPx": 760,
              "Tags": [ "Rules", "Operations" ],
              "AllowedRoles": [ "Lead", "Admin" ]
            }
          ]
        }
      ]
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "RateLimiting": {
    "AuthToken": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Write": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Read": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Infrastructure": {
    "Scanning": {
      "PreferScripts": true,
      "AllowConnectorFallback": true,
      "PowerShellExecutable": "powershell.exe",
      "AcceptNewHostKey": true,
      "DefaultSigmaMinutesBack": 60,
      "SigmaCustomRulesDirectory": "C:/Tools/Sigma/custom_rules",
      "Scripts": {
        "yara": "scripts/Invoke-YaraScan.ps1",
        "sigma": "scripts/Invoke-SigmaScan.ps1",
        "snort": "scripts/Invoke-SnortScan.ps1",
        "suricata": "scripts/Invoke-SuricataScan.ps1"
      }
    }
  }
}
