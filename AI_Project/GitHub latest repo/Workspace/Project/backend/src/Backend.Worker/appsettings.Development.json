  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Jobs": {
    "ModelRetrainingIntervalHours": 12
  }
}
